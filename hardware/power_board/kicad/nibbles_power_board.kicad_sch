			(justify left bottom)
		)
		(uuid "d274dbb6-6f5c-55fe-ad90-8945d22259a6")
	)
	(text "pins (LEMO 1-3 +, 4-6 ground), J7 (JST-PH 3) its data (LEMO 7, UART to the base), dock detect (8) and a ground."
		(exclude_from_sim no)
		(at 25.4 80.01 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d3a7c511-db3e-513f-95f3-f1727f1e23ec")
	)
	(text "The pack's can be switched off (PACK_OFF) while the dock runs the lights; its FET's body diode still holds the bus"
		(exclude_from_sim no)
		(at 25.4 233.68 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "e9ded90c-c3d9-5580-80d3-dc47ae22e08a")
	)
	(text "Charger port: J10 (XT30, DOCK_VIN out to the charger), J11 (XT30, the charger's battery output into PACK_F),"
		(exclude_from_sim no)
		(at 25.4 485.14 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ef354166-7d14-576d-838c-4c986c72ea06")
	)
	(text "TCA9534 at 0x20 (A0-A2 = GND): P0 LIGHT_OFF, P1 PACK_OFF (outputs); P3 EFUSE_PG (input); P2, P4-P7 spare."
		(exclude_from_sim no)
		(at 25.4 469.9 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "efe4a39f-c436-5413-aa52-39c7da07f2c1")
	)
	(text "the lights: without it, the pack would feed the charger's input through LIGHT_BUS."
		(exclude_from_sim no)
		(at 25.4 95.25 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f0d267b6-a5d8-5eb2-a920-634501f3a7bb")
	)
	(text "converter's input while the ideal diodes switch between dock and pack."
		(exclude_from_sim no)
		(at 25.4 229.87 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "fc2ae587-3508-5d1c-b5ef-367ca10cfd31")
	)
