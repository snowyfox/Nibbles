	(text "Upper keypad (3 keys): 3 Kailh Box Navy switches (MX pins) in Kailh hotswap sockets on the back, 16 mm pitch,"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "797830c1-ea04-5ca1-810e-ebd1268500d7")
	)
	(text "an SK6812MINI-E under each switch's LED window (mounted on the back, shining through), and a TCA9534A"
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ce51814b-5122-5d5e-8b03-4ee6aaf28000")
	)
	(text "(I2C 0x38-0x3F, set by JP1-JP3; default 0x38) reading the keys: pressed = low, INT on any change."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f99c855a-c284-5f30-9811-8145d3571eee")
	)
	(text "Address: JP1-JP3 are A0-A2, bridged 1-2 (0) as made; cut 1-2 and bridge 2-3 for a 1. Give each board its own."
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4248d7d4-6c66-5ea5-a61d-d103faca6acb")
	)
	(text "J1 to the keypad hub (JST-GH 8): 1 GND, 2 +3V3, 3 SDA, 4 SCL, 5 INT, 6 +5V, 7 LED data in, 8 LED data out."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "16e25d37-fad9-59c6-9271-fe031df245e9")
	)
	(text "The 3.49 drives the LED data (GPIO 43 via the hub's 5 V buffer); the chain runs through every board in turn."
		(exclude_from_sim no)
		(at 25.4 34.29 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "960a42fd-84b6-5dee-b1e8-1ffceb9854eb")
	)
	(text "P3-P7 are unused, held high by RN1/RN2."
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5d640ff5-1b40-5f88-b6ee-e09f00def4e2")
	)
