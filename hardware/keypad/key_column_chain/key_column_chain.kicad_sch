	(text "Key column, daisy chain (8 keys): 8 Kailh Box Navy switches (MX pins) in Kailh hotswap sockets on the back, 16 mm pitch,"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "81b1d666-e4de-5aaf-a351-e080ee55f23e")
	)
	(text "an SK6812MINI-E under each switch's LED window (mounted on the back, shining through), and a TCA9534A"
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1a29b8c4-fe6b-5cb0-84fd-759322104865")
	)
	(text "(I2C 0x38-0x3F, set by JP1-JP3; default 0x38) reading the keys: pressed = low, INT on any change."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f484cde7-ab4a-5764-8eee-97f4584f289e")
	)
	(text "Address: JP1-JP3 are A0-A2, bridged 1-2 (0) as made; cut 1-2 and bridge 2-3 for a 1. Give each board its own."
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0fec85b4-caa9-5daa-94b2-f582903ec81b")
	)
	(text "Daisy chain: J1 in, J2 out to the next board, straight through: 1 GND, 2 +3V3, 3 SDA, 4 SCL, 5 INT, 6 +5V,"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1ca1e4b1-399a-501b-8155-cb7333683122")
	)
	(text "7 LED data (in on J1, out on J2), 8 unused. U3 buffers the data in to 5 V (SK6812 needs 0.7 VDD), so any"
		(exclude_from_sim no)
		(at 25.4 34.29 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f1747e11-1ba7-5f19-9244-e0d8dae56046")
	)
	(text "board can be first, fed by the 3.49's GPIO 43."
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f16cf033-f8fb-595c-92a0-238b9c18e7b6")
	)
