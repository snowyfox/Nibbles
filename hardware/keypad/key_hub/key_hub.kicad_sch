	(text "Keypad hub: J1 takes the power board's keypad port (J9, JST-GH 6 on pins 1-6) plus one wire from the 3.49's"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5080a7d3-1c04-5694-be86-10d668bfbc18")
	)
	(text "GPIO 43 (the power board's J6 pad B5) on pin 7. J2-J5 go to key boards (same GH8 pinout as theirs)."
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ab9968fc-e4ef-54cd-bf97-58f5a6dc1bf2")
	)
	(text "U1 buffers the LED data to 5 V (SK6812 needs 0.7 VDD). It runs J2 in -> J2 out -> J3 in ... J5 out:"
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "976ae5db-4367-5645-a79a-b99aa682caea")
	)
	(text "fill the ports in order, or bridge a port's JP to skip it. R1 holds the data low with the cable out."
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "151a24f5-0c28-561c-b2b5-bcf168ec217c")
	)
	(text "I2C pull-ups are on the power board (4.7k); INT is open drain, pulled up there (10k)."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "7e534df4-c9d2-5abb-b6ab-d781294adf09")
	)
