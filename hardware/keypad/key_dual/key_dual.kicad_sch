	(text "Key board, 16 keys: two columns of 8 Kailh Box Navy switches (MX pins) in Kailh hotswap sockets on the back,"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "36bec4d0-7128-5ec2-a0b8-2bb328c77bc8")
	)
	(text "16 mm pitch both ways, an SK6812MINI-E under each switch's LED window (on the back, shining through)."
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "a88992b1-f223-5f34-8e85-e11b91f6dd89")
	)
	(text "U1 reads column A (keys 1-8, top down), U2 column B (keys 9-16): TCA9534A, pressed = low, INT on any change."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "fac2042c-8849-5b19-b0f9-0622b46dd7fb")
	)
	(text "Addresses 0x38-0x3F: JP1-JP3 are U1's A0-A2, JP4-JP6 U2's, all bridged 1-2 (0) as made; cut 1-2 and bridge"
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "38d6b4ca-b3da-54f1-9bf3-1a0ec67ac819")
	)
	(text "2-3 for a 1. Every expander in the chain needs its own address (U2: cut JP4 to 2-3 for 0x39)."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "0ef081a7-0c0d-5ead-b75c-45776ae11f64")
	)
	(text "Daisy chain: J1 in, J2 out to the next board, straight through: 1 GND, 2 +3V3, 3 SDA, 4 SCL, 5 INT, 6 +5V,"
		(exclude_from_sim no)
		(at 25.4 34.29 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "2074d83a-13b2-5e06-ade3-cc3eaa427928")
	)
	(text "7 LED data (in on J1, out on J2), 8 unused. U3 buffers the data in to 5 V (SK6812 needs 0.7 VDD), so any"
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "86281f7c-6805-5bf5-9fc3-2309c8d84ade")
	)
	(text "board can be first, fed by the 3.49's GPIO 43. The LEDs run down column A, then down column B."
		(exclude_from_sim no)
		(at 25.4 41.91 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "d08672f8-290c-5941-9571-60ac634090fd")
	)
