	(text "Key board, two chain columns (16 keys): 8 Kailh Box Navy switches (MX pins) in Kailh hotswap sockets on the back, 16 mm pitch,"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "32ecbe18-0457-5507-8e1d-067630528c3b")
	)
	(text "an SK6812MINI-E under each switch's LED window (mounted on the back, shining through), and a TCA9534A"
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "bde70353-cdf9-5c94-a32c-f3777dcdb837")
	)
	(text "(I2C 0x38-0x3F, set by JP1-JP3; default 0x38) reading the keys: pressed = low, INT on any change."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "ef51992e-e440-5915-b1d5-14863081c967")
	)
	(text "Address: JP1-JP3 are A0-A2, bridged 1-2 (0) as made; cut 1-2 and bridge 2-3 for a 1. Give each board its own."
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "657fe6c8-8e53-5a89-840b-aff501c43e4d")
	)
	(text "Daisy chain: J1 in, J2 out to the next board, straight through: 1 GND, 2 +3V3, 3 SDA, 4 SCL, 5 INT, 6 +5V,"
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "5503ab29-2f3c-5465-8b31-3b450af704d1")
	)
	(text "7 LED data (in on J1, out on J2), 8 unused. U3 buffers the data in to 5 V (SK6812 needs 0.7 VDD), so any"
		(exclude_from_sim no)
		(at 25.4 34.29 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b00a637e-6ec0-5be8-8105-8cbd2862da88")
	)
	(text "board can be first, fed by the 3.49's GPIO 43."
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "905c405d-61b9-5453-bb0b-6e95faf33674")
	)
	(text "Two copies of the chain column side by side, 18 mm apart: column A on the left (refs as key_column_chain),"
		(exclude_from_sim no)
		(at 25.4 41.91 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "4e6f16fe-3831-5578-b428-36c50016464a")
	)
	(text "column B on the right (refs + 100, nets _B). Chain A's J2 to B's J101 with a short GH8 cable, or use them"
		(exclude_from_sim no)
		(at 25.4 45.72 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "34b187c1-094e-52d4-a032-1d3f2662c49a")
	)
	(text "apart. Give B its own address: cut JP101 to 2-3 for 0x39."
		(exclude_from_sim no)
		(at 25.4 49.53 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b90d8ff0-354c-5e22-8581-e4abb4cacba3")
	)
