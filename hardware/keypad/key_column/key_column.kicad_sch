	(text "Key column (8 keys): 8 Kailh Box Navy switches (MX pins) in Kailh hotswap sockets on the back, 16 mm pitch,"
		(exclude_from_sim no)
		(at 25.4 15.24 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "1e1292ca-4826-5556-b297-133bae734204")
	)
	(text "an SK6812MINI-E under each switch's LED window (mounted on the back, shining through), and a TCA9534A"
		(exclude_from_sim no)
		(at 25.4 19.05 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "bc30cd84-8487-5d51-a63c-5a23c032c8b8")
	)
	(text "(I2C 0x38-0x3F, set by JP1-JP3; default 0x38) reading the keys: pressed = low, INT on any change."
		(exclude_from_sim no)
		(at 25.4 22.86 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f7f4d8f8-ed06-5111-b107-343333e20b3a")
	)
	(text "Address: JP1-JP3 are A0-A2, bridged 1-2 (0) as made; cut 1-2 and bridge 2-3 for a 1. Give each board its own."
		(exclude_from_sim no)
		(at 25.4 26.67 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "b8bdd9a5-005c-5673-9504-c64143f7bda8")
	)
	(text "J1 to the keypad hub (JST-GH 8): 1 GND, 2 +3V3, 3 SDA, 4 SCL, 5 INT, 6 +5V, 7 LED data in, 8 LED data out."
		(exclude_from_sim no)
		(at 25.4 30.48 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "f6c14a51-33fa-5dad-b0d7-ee7962441597")
	)
	(text "The 3.49 drives the LED data (GPIO 43 via the hub's 5 V buffer); the chain runs through every board in turn."
		(exclude_from_sim no)
		(at 25.4 34.29 0)
		(effects
			(font
				(size 2 2)
			)
			(justify left bottom)
		)
		(uuid "769bf9e5-66d6-5aa7-9470-ceb6e87deb40")
	)
