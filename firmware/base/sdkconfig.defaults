# Waveshare ESP32-S3-Touch-LCD-3.49: ESP32-S3R8, 16 MB flash, 8 MB octal PSRAM
CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# LVGL status screen
CONFIG_LV_COLOR_DEPTH_16=y
# the C library's memcpy/memset (much faster than LVGL's own; 2026-11-03)
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_40=y

# Two 6 MB app slots for updates over Wi-Fi or the mirror cable (partitions.csv,
# main/ota.c); a new image that doesn't come up properly is rolled back.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# The main loop copies the keypad state and builds the screen status on its
# stack; the default 3.5 KB overflowed once Standby got palettes and layers.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
