# Waveshare ESP32-S3-AMOLED-1.91 as the base's main board (2026-11-14): added
# after sdkconfig.defaults by tools: see "Two boards" in CLAUDE.md.
CONFIG_BASE_BOARD_AMOLED_191=y

# Bluetooth, only to set the clock from a phone at boot (main/ble_time.c):
# NimBLE as a peripheral that reads the phone's Current Time Service, with
# pairing (bonds kept in NVS). Off again once the time is set.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=y
# The GATT client (reading the phone) needs the central role in ESP-IDF's Kconfig.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_GATT_CLIENT=y
CONFIG_ESP_COEX_SW_COEXIST_ENABLE=y
# Bluetooth's buffers in PSRAM: in internal RAM they left too little for the
# logger and keypad tasks to start (2026-11-14).
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
